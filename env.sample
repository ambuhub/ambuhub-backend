# Copy to .env and adjust. Do not commit real secrets.

FRONTEND_URL=http://localhost:3000
PORT=3002

# Paystack (test or live keys from your Paystack dashboard)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# Firebase Admin (required in production for FCM push)
# Option A: individual env vars
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option B: path to service account JSON (local dev only)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Google Maps (Geocoding + Routes API for dispatch)
GOOGLE_MAPS_SERVER_API_KEY=

# Resend (transactional email — OTP verification)
RESEND_API_KEY=
# Optional verified sender. Defaults to Ambuhub <onboarding@resend.dev>
# RESEND_FROM_EMAIL=Ambuhub <noreply@yourdomain.com>

# Dispatch tuning (optional)
DISPATCH_OFFER_TIMEOUT_MS=240000
DISPATCH_LOCATION_STALE_MS=300000
# Max simultaneous search attempts (searching/offered) per client per hour
DISPATCH_MAX_REQUESTS_PER_HOUR=5
